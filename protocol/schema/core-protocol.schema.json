{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreProtocol",
  "description": "主进程与实时核之间核连接上的消息，由 core/crates/core-protocol 生成。",
  "x-protocol-version": 1,
  "x-methods": {
    "core.hello": {
      "direction": "core_to_main",
      "params": {
        "$ref": "#/$defs/CoreHelloParams"
      },
      "result": {
        "$ref": "#/$defs/CoreHelloResult"
      }
    },
    "frame_ring.attach": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/FrameRingAttachParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "capture.set_target": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/CaptureSetTargetParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "audio_ring.attach": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/AudioRingAttachParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "audio.set_target": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/AudioSetTargetParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "producer.heartbeat": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/ProducerHeartbeatParams"
      },
      "result": null
    },
    "action.submit": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/ActionBlock"
      },
      "result": {
        "$ref": "#/$defs/ActionSubmitResult"
      }
    },
    "producer.revoke": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/ProducerRevokeParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "core.stop": {
      "direction": "main_to_core",
      "params": {
        "$ref": "#/$defs/Empty"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "action.receipt": {
      "direction": "core_to_main",
      "params": {
        "$ref": "#/$defs/ActionReceiptParams"
      },
      "result": null
    },
    "input.released": {
      "direction": "core_to_main",
      "params": {
        "$ref": "#/$defs/InputReleasedParams"
      },
      "result": null
    },
    "core.health": {
      "direction": "core_to_main",
      "params": {
        "$ref": "#/$defs/CoreHealthParams"
      },
      "result": null
    }
  },
  "x-test-device-methods": {
    "test_lease.grant": {
      "direction": "test_to_core",
      "params": {
        "$ref": "#/$defs/FakeLeaseGrantParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "test_lease.revoke": {
      "direction": "test_to_core",
      "params": {
        "$ref": "#/$defs/FakeLeaseRevokeParams"
      },
      "result": {
        "$ref": "#/$defs/Empty"
      }
    },
    "fake_input.event": {
      "direction": "core_to_test",
      "params": {
        "$ref": "#/$defs/FakeInputEventParams"
      },
      "result": null
    }
  },
  "x-error-codes": {
    "protocol_version_mismatch": -32001,
    "frame_ring_mismatch": -32002,
    "capture_unsupported": -32003,
    "lease_refused": -32004,
    "audio_ring_mismatch": -32005
  },
  "$defs": {
    "CoreHelloParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "实时核实现的核协议版本。",
          "maximum": 4294967295
        },
        "core_version": {
          "type": "string",
          "description": "实时核的程序版本，只用于日志与诊断。"
        }
      },
      "required": [
        "protocol_version",
        "core_version"
      ],
      "description": "`core.hello` 的 params：实时核通过通道认证后发出的第一条消息。"
    },
    "CoreHelloResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "主进程实现的核协议版本。",
          "maximum": 4294967295
        }
      },
      "required": [
        "protocol_version"
      ],
      "description": "`core.hello` 的 result：主进程接受握手。"
    },
    "FrameRingAttachParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "共享内存名。"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "共享内存的总字节数。",
          "maximum": 18446744073709551615
        },
        "layout_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "帧环的布局版本。",
          "maximum": 4294967295
        },
        "slot_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "槽数。",
          "maximum": 4294967295
        },
        "slot_stride": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "相邻两槽起点之间的字节数。",
          "maximum": 18446744073709551615
        },
        "max_width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "帧的最大宽度（物理像素）。",
          "maximum": 4294967295
        },
        "max_height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "帧的最大高度（物理像素）。",
          "maximum": 4294967295
        }
      },
      "required": [
        "name",
        "size_bytes",
        "layout_version",
        "slot_count",
        "slot_stride",
        "max_width",
        "max_height"
      ],
      "description": "`frame_ring.attach` 的 params：主进程创建的帧环的共享内存名与布局参数。"
    },
    "Empty": {
      "type": "object",
      "additionalProperties": false,
      "description": "不带字段的 params 或 result。"
    },
    "CaptureSetTargetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/CaptureTarget",
          "description": "采集目标。"
        }
      },
      "required": [
        "target"
      ],
      "description": "`capture.set_target` 的 params。"
    },
    "CaptureTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "window"
            },
            "process_name": {
              "type": "string",
              "description": "进程的可执行文件名，不区分大小写。"
            },
            "window_class": {
              "type": [
                "string",
                "null"
              ],
              "description": "窗口类名，全等匹配；`null` 表示不按窗口类匹配。"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "窗口标题，全等匹配；`null` 表示不按标题匹配。"
            }
          },
          "required": [
            "type",
            "process_name"
          ],
          "title": "WindowTarget",
          "description": "窗口识别规则：进程名加窗口类或标题，至少给出窗口类与标题之一。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "fake"
            },
            "surface": {
              "$ref": "#/$defs/FrameRingAttachParams",
              "description": "假显示面的共享内存名与布局参数。假显示面与帧环同一布局，参数的含义与核对同 `frame_ring.attach`。"
            }
          },
          "required": [
            "type",
            "surface"
          ],
          "title": "FakeTarget",
          "description": "假采集源，只用于自动测试：从测试一侧创建并写入的假显示面取帧。"
        }
      ],
      "description": "采集目标：按规则识别的游戏窗口，或测试用的假采集源。",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "AudioRingAttachParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "共享内存名。"
        },
        "size_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "共享内存的总字节数。",
          "maximum": 18446744073709551615
        },
        "layout_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "音频环的布局版本。",
          "maximum": 4294967295
        },
        "block_count": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "块槽数。",
          "maximum": 4294967295
        },
        "block_stride": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "相邻两块槽起点之间的字节数。",
          "maximum": 18446744073709551615
        },
        "block_capacity": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "一块最多的采样点数。",
          "maximum": 4294967295
        },
        "sample_rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "采样率（Hz）。",
          "maximum": 4294967295
        },
        "channels": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "声道数。",
          "maximum": 4294967295
        },
        "sample_format": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0,
          "description": "样本格式。",
          "maximum": 4294967295
        }
      },
      "required": [
        "name",
        "size_bytes",
        "layout_version",
        "block_count",
        "block_stride",
        "block_capacity",
        "sample_rate",
        "channels",
        "sample_format"
      ],
      "description": "`audio_ring.attach` 的 params：主进程创建的音频环的共享内存名与布局参数。"
    },
    "AudioSetTargetParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "$ref": "#/$defs/AudioTarget",
          "description": "音频目标。"
        }
      },
      "required": [
        "target"
      ],
      "description": "`audio.set_target` 的 params。"
    },
    "AudioTarget": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "window"
            },
            "process_name": {
              "type": "string",
              "description": "进程的可执行文件名，不区分大小写。"
            },
            "window_class": {
              "type": [
                "string",
                "null"
              ],
              "description": "窗口类名，全等匹配；`null` 表示不按窗口类匹配。"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "description": "窗口标题，全等匹配；`null` 表示不按标题匹配。"
            }
          },
          "required": [
            "type",
            "process_name"
          ],
          "title": "AudioWindowTarget",
          "description": "采这个窗口所属进程及其子进程的声音。识别规则与 `capture.set_target` 的 `window` 相同。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "fake"
            },
            "output": {
              "$ref": "#/$defs/AudioRingAttachParams",
              "description": "假音频输出的共享内存名与布局参数。假音频输出与音频环同一布局，参数的含义与核对同\n`audio_ring.attach`。"
            }
          },
          "required": [
            "type",
            "output"
          ],
          "title": "FakeAudioTarget",
          "description": "假音频源，只用于自动测试：从测试一侧创建并写入的假音频输出取声音。"
        }
      ],
      "description": "音频目标：按窗口识别规则认定的游戏进程，或测试用的假音频源。",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "ProducerHeartbeatParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": {
          "$ref": "#/$defs/Producer",
          "description": "发出心跳的控制产出者。"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "心跳序号，同一代次内严格递增。",
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "producer",
        "seq"
      ],
      "description": "`producer.heartbeat` 的 params：当前控制产出者的心跳。"
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "控制产出者的身份。"
        },
        "generation": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "代次，由主进程分配，在一个实时核的生命期内严格递增。",
          "maximum": 18446744073709551615
        }
      },
      "required": [
        "id",
        "generation"
      ],
      "description": "控制产出者的身份与代次。"
    },
    "ActionBlock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": {
          "$ref": "#/$defs/Producer",
          "description": "产出这块动作的控制产出者。"
        },
        "seq": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "动作块序号，同一代次内严格递增。",
          "maximum": 18446744073709551615
        },
        "base_frame": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "基准帧号：产出者做决定时依据的帧，坐标按这一帧的客户区解释。",
          "maximum": 18446744073709551615
        },
        "start_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "起始时刻。",
          "maximum": 18446744073709551615
        },
        "deadline_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "有效截止时刻：到时还没有新的动作块，实时核即释放全部输入。",
          "maximum": 18446744073709551615
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ControlStep"
          },
          "description": "按时间排列的控制步，至少一步。"
        }
      },
      "required": [
        "producer",
        "seq",
        "base_frame",
        "start_ns",
        "deadline_ns",
        "steps"
      ],
      "description": "`action.submit` 的 params：主进程向实时核提交的唯一动作形式。"
    },
    "ControlStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "offset_ns": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "description": "相对起始时刻的纳秒数，在块内不减。",
          "maximum": 18446744073709551615
        },
        "held": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/HeldInput"
          },
          "description": "完整的持续状态：列出的保持按下或保持取值，没列出的一律释放。"
        },
        "actions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          },
          "description": "一次性动作，按列出的顺序执行。"
        }
      },
      "required": [
        "offset_ns",
        "held",
        "actions"
      ],
      "description": "动作块中的一步：从这一步的时刻起生效的完整持续状态，以及在这一时刻执行的一次性动作。"
    },
    "HeldInput": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "key"
            },
            "scan_code": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535,
              "description": "扫描码（Set 1）；扩展键在高字节带 `0xE0`。"
            }
          },
          "required": [
            "type",
            "scan_code"
          ],
          "title": "HeldKey",
          "description": "按住的键。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "mouse_button"
            },
            "button": {
              "$ref": "#/$defs/MouseButton",
              "description": "鼠标键。"
            }
          },
          "required": [
            "type",
            "button"
          ],
          "title": "HeldMouseButton",
          "description": "按住的鼠标键。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "axis"
            },
            "axis": {
              "type": "string",
              "description": "轴名，由游戏适配包的白名单定义。"
            },
            "value": {
              "type": "number",
              "format": "double",
              "description": "取值，范围 [-1, 1]。"
            }
          },
          "required": [
            "type",
            "axis",
            "value"
          ],
          "title": "HeldAxis",
          "description": "轴的取值。"
        }
      ],
      "description": "持续状态的一项。",
      "discriminator": {
        "propertyName": "type"
      }
    },
    "MouseButton": {
      "oneOf": [
        {
          "type": "string",
          "const": "left",
          "description": "左键。"
        },
        {
          "type": "string",
          "const": "right",
          "description": "右键。"
        },
        {
          "type": "string",
          "const": "middle",
          "description": "中键。"
        }
      ],
      "description": "鼠标键。"
    },
    "Action": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "click"
            },
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "description": "动作身份，在同一代次内唯一。",
              "maximum": 18446744073709551615
            },
            "x": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "客户区横坐标（物理像素）。",
              "maximum": 4294967295
            },
            "y": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "客户区纵坐标（物理像素）。",
              "maximum": 4294967295
            },
            "button": {
              "$ref": "#/$defs/MouseButton",
              "description": "鼠标键。"
            }
          },
          "required": [
            "type",
            "id",
            "x",
            "y",
            "button"
          ],
          "title": "Click",
          "description": "点击：移到客户区坐标处按下并抬起；按住时长由游戏适配包给出。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "key_press"
            },
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "description": "动作身份，在同一代次内唯一。",
              "maximum": 18446744073709551615
            },
            "scan_code": {
              "type": "integer",
              "format": "uint16",
              "minimum": 0,
              "maximum": 65535,
              "description": "扫描码（Set 1）；扩展键在高字节带 `0xE0`。"
            }
          },
          "required": [
            "type",
            "id",
            "scan_code"
          ],
          "title": "KeyPress",
          "description": "短按：按下并抬起一个键；按住时长由游戏适配包给出。"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "type": "string",
              "const": "scroll"
            },
            "id": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0,
              "description": "动作身份，在同一代次内唯一。",
              "maximum": 18446744073709551615
            },
            "x": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "客户区横坐标（物理像素）。",
              "maximum": 4294967295
            },
            "y": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0,
              "description": "客户区纵坐标（物理像素）。",
              "maximum": 4294967295
            },
            "notches": {
              "type": "integer",
              "format": "int32",
